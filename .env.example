# Конфигурация приложения
APP_URL=http://localhost
APP_ENV=development

# База данных
DB_HOST=localhost
DB_PORT=3306
DB_NAME=contacts_db
DB_USER=root
DB_PASSWORD=

# Почтовый сервис
MAIL_DRIVER=smtp

# SMTP Configuration
# Для Яндекс 360: используйте пароль приложения, а не основной пароль
# Для Gmail: включите 2FA и создайте пароль приложения
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=your-email@yourdomain.ru
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.ru
SMTP_FROM_NAME="Your Company Name"
SMTP_TIMEOUT=30
SMTP_DEBUG=0

# Настройки очереди
QUEUE_ENABLED=true
QUEUE_BATCH_SIZE=50
QUEUE_DELAY_BATCHES=60
QUEUE_DELAY_EMAILS=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY=300

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_PER_DAY=1000

# Tracking (отслеживание открытий и кликов)
TRACKING_ENABLED=true
TRACKING_PIXEL_ENABLED=true
TRACKING_LINK_ENABLED=true

# Безопасность
MAX_ATTACHMENT_SIZE=10485760

# Логирование
LOG_LEVEL=info

# Сессия
SESSION_LIFETIME=7200
